# SECURITY WARNING: NEVER commit this file or any .env file containing real keys/secrets to GitHub!
# Make sure .env is added to your .gitignore (already set up in this repo).

# ==========================================
# Google Gemini Settings (Natively Supported)
# ==========================================
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the model used by the researcher sample agent
ADK_RESEARCH_MODEL=gemini-2.5-flash
ADK_FORMAT_MODEL=gemini-2.5-flash

# ==========================================
# Other AI Providers (Multi-Provider Support)
# ==========================================
# Add keys below if you want to experiment with other providers.
# These will be automatically picked up by underlying SDKs.
#
# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
