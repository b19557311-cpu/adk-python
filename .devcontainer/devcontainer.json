{
  "name": "ADK Dev Container",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "ADK Web UI",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
